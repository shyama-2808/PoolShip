PROJECT_NAME="PoolShip API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
SECRET_KEY="poolship_super_secret_jwt_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql+asyncpg://poolship:poolship_secret@localhost:5432/poolship_db"
SYNC_DATABASE_URL="postgresql://poolship:poolship_secret@localhost:5432/poolship_db"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Routing Service (OSRM / OpenStreetMap)
OSRM_BASE_URL="https://router.project-osrm.org"
